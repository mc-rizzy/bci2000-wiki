UsrTask int RestingPeriod= 0 0 0 1 // 1 defines a rest period of data acquisition
UsrTask int RewardDuration= 10 0 0 1 // Duration of PostTrial Feedback
Source int SampleBlockSize= 16 5 1 128 // this is the number of samples transmitted at a time
Source int SamplingRate= 160 128 1 4000 // this is the sample rate
