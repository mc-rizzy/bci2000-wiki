UsrTask float TargetHeight= 100 0 0 1 // Height of Targets in Pixels
UsrTask int TargetOrientation= 1 0 0 1 // Orientation 1= Vertical 2= Horizontal 3= Both
UsrTask float TargetWidth= 100 0 0 1 // Width of Targets in Pixels
Statistics int TargetWinLth= 20 0 0 100 // Length of Target % Window
UsrTask int TimeLimit= 120 180 0 1000 // Time Limit for Runs in seconds
