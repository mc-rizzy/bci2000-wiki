Storage string FileInitials= c:\bci2000\data\screen\gvn a z 0 // path to top level data directory
UsrTask int ItiDuration= 40 0 0 1 // Duration of Intertrial Interval
MEMFilter float MemBandWidth= 3.0 3.0 0.5 32.0 // Spectral Bandwidth in Hz
MEMFilter int MemDetrend= 0 0 0 2 // Detrend data?  0=no 1=mean 2= linear
