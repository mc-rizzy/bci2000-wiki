#/bin/sh

brew --version > /dev/null
if [ "$?" -ne 0 ]
then
	mkdir src/extlib/homebrew && curl -L https://github.com/Homebrew/brew/tarball/main | tar xz --strip 1 -C src/extlib/homebrew
	BREW=src/extlib/homebrew/bin/brew
else
	BREW=brew
fi

pkg-config --help 2>&1 > /dev/null
if [ "$?" -ne 0 ]
then
	echo "Installing pkg-config"
	${BREW} install pkg-config
	PKGCONFIG=src/extlib/homebrew/bin/pkg-config
else
	echo "pkg-config already installed"
	PKGCONFIG=pkg-config
fi

if ! ${BREW} list curl > /dev/null
then
	${BREW} install curl
#	${BREW} link curl
fi

echo "Installing ffmpeg ( 1 / 6 )..."
if ! ${BREW} list ffmpeg@8 > /dev/null
then
	${BREW} install ffmpeg@8
	${BREW} link ffmpeg@8
fi

echo "Installing fftw ( 2 / 6 )..."
if ! ${BREW} list fftw > /dev/null
then
	${BREW} install fftw
	${BREW} link fftw
fi

echo "Installing PortAudio ( 3 / 6 )..."
$PKGCONFIG portaudio-2.0
if [[ "$?" -ne 0 && ! -d ${BREW}/../../Cellar/portaudio ]]
then
	${BREW} install portaudio
fi

echo "Installing libsndfile ( 4 / 6 )..."
$PKGCONFIG sndfile
if [[ "$?" -ne 0 && ! -d ${BREW}/../../Cellar/sndfile ]]
then
	${BREW} install libsndfile
fi

echo "Installing dylibbundler ( 5 / 6 )..."
if ! ${BREW} list dylibbundler > /dev/null
then
	${BREW} install dylibbundler
fi

echo "Installing zeromq ( 6 / 6 )..."
if ! ${BREW} list zeromq > /dev/null
then
	${BREW} install zeromq
fi

