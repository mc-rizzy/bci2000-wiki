	$(MAKE) $(MAKESILENT) -f CMakeFiles/core/Tools/cmdline/CMakeFiles/bci_stream2hybrid.dir/build.make CMakeFiles/core/Tools/cmdline/CMakeFiles/bci_stream2hybrid.dir/build
.PHONY : bci_stream2hybrid/fast

