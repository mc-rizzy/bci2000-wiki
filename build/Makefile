# Convenience rules to build test dependencies.

# Build the dependencies of a test.
test_prep/LibTiny: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 test_prep/LibTiny
.PHONY : test_prep/LibTiny

